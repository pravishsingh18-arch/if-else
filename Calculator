class Calculator {
    public static void main(String[] args) {

        int a = 10;
        int b = 5;
        char op = '+';

        if (op == '+') {
            System.out.println(a + b);
        }
        else if (op == '-') {
            System.out.println(a - b);
        }
        else if (op == '*') {
            System.out.println(a * b);
        }
        else if (op == '/') {
            System.out.println(a / b);
        }
        else {
            System.out.println("Invalid Operator");
        }

    }
}
